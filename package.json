{
  "name": "@olivierzal/configs",
  "version": "6.6.0",
  "description": "Shared tooling presets for the OlivierZal repo family: eslint, prettier, tsconfig, typedoc and vitest fragments",
  "keywords": [
    "configs",
    "eslint",
    "prettier",
    "tsconfig"
  ],
  "homepage": "https://github.com/OlivierZal/configs#readme",
  "bugs": {
    "url": "https://github.com/OlivierZal/configs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OlivierZal/configs.git"
  },
  "license": "MIT",
  "author": "Olivier Zalmanski",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./eslint/homey-app": {
      "types": "./dist/eslint/homey-app.d.ts",
      "default": "./dist/eslint/homey-app.js"
    },
    "./eslint/library": {
      "types": "./dist/eslint/library.d.ts",
      "default": "./dist/eslint/library.js"
    },
    "./prettier": {
      "types": "./dist/prettier/index.d.ts",
      "default": "./dist/prettier/index.js"
    },
    "./tsconfig/app": "./tsconfig-bases/app.json",
    "./tsconfig/library": "./tsconfig-bases/library.json",
    "./typedoc": {
      "types": "./dist/typedoc/index.d.ts",
      "default": "./dist/typedoc/index.js"
    },
    "./vitest-coverage": {
      "types": "./dist/vitest/coverage.d.ts",
      "default": "./dist/vitest/coverage.js"
    },
    "./vitest-swc": {
      "types": "./dist/vitest/swc.d.ts",
      "default": "./dist/vitest/swc.js"
    }
  },
  "types": "dist/eslint/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "src",
    "tsconfig-bases"
  ],
  "scripts": {
    "build": "rm -rf dist && node ./node_modules/@typescript/native/bin/tsc --project tsconfig.build.json",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "npm run lint -- --fix",
    "lint:package": "npm run build && publint --strict",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck && npm run lint && npm run format",
    "test": "vitest run",
    "test:coverage": "npm test -- --coverage",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-package-json": "^1.9.0",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "eslint-plugin-yml": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^1.5.11"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "prettier": ">=3.5",
    "vitest": ">=4"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
